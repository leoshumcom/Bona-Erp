generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== 组织与权限 ==========

model Company {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  departments Department[]
  users      User[]

  @@map("companies")
}

model Department {
  id        String   @id @default(uuid())
  name      String
  companyId String   @map("company_id")
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  company   Company  @relation(fields: [companyId], references: [id])
  parent    Department? @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children  Department[] @relation("DepartmentHierarchy")
  users     User[]

  @@map("departments")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  realName      String   @map("real_name")
  email        String?
  phone        String?
  role         String   @default("operator") // admin / boss / factory_manager / warehouse_manager / operator / aftersales
  status       String   @default("active")   // active / disabled
  departmentId String?  @map("department_id")
  companyId    String   @map("company_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  department   Department? @relation(fields: [departmentId], references: [id])
  company      Company    @relation(fields: [companyId], references: [id])

  @@map("users")
}

// ========== 平台与店铺 ==========

model Platform {
  id        String   @id @default(uuid())
  name      String   @unique // Amazon / TikTokShop / Temu / Shopee 等
  code      String   @unique
  apiBase   String?  @map("api_base")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  stores    Store[]

  @@map("platforms")
}

model Store {
  id          String   @id @default(uuid())
  name        String
  storeId     String   @map("store_id") // 平台店铺ID
  platformId  String   @map("platform_id")
  site        String?  // 站点（如北美站、欧洲站）
  tokenInfo   Json?    @map("token_info") // API授权信息
  storeType   String   @default("self") @map("store_type") // self / managed
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  platform       Platform       @relation(fields: [platformId], references: [id])
  storeProducts  StoreProduct[]
  orders         Order[]
  adCampaigns    AdCampaign[]

  @@map("stores")
}

// ========== 产品与SKU ==========

model Product {
  id        String   @id @default(uuid())
  sku       String   @unique
  name      String
  nameEn    String?  @map("name_en")
  category  String?
  imageUrl  String?  @map("image_url")
  weight    Decimal? @db.Decimal(10, 3)
  dimensions Json?   // 长宽高
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  storeProducts StoreProduct[]
  orders         Order[]
  molds       Mold[]
  materials   BOMItem[]
  productionOrders ProductionOrder[]

  @@map("products")
}

model StoreProduct {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  productId   String   @map("product_id")
  storeSku    String?  @map("store_sku")
  asin        String?
  listingUrl  String?  @map("listing_url")
  currentPrice Decimal? @db.Decimal(10, 2) @map("current_price")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  store       Store    @relation(fields: [storeId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])

  @@unique([storeId, productId])
  @@map("store_products")
}

// ========== 工厂端 - 模具管理 ==========

model Mold {
  id              String   @id @default(uuid())
  moldCode        String   @unique @map("mold_code")
  productId       String   @map("product_id")
  moldCost        Decimal  @db.Decimal(12, 2) @map("mold_cost")
  lifespan        Int      // 使用寿命（生产次数）
  depreciationMethod String @default("per_unit") @map("depreciation_method") // per_unit / per_month
  startDate       DateTime @map("start_date")
  scrapDate       DateTime? @map("scrap_date")
  status          String   @default("active") // active / maintained / scrapped
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  product         Product  @relation(fields: [productId], references: [id])
  expenses        MoldExpense[]
  depreciations   MoldDepreciation[]

  @@map("molds")
}

model MoldExpense {
  id         String   @id @default(uuid())
  moldId     String   @map("mold_id")
  type       String   // repair / maintenance / modification
  amount     Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @map("expense_date")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  mold       Mold     @relation(fields: [moldId], references: [id])

  @@map("mold_expenses")
}

model MoldDepreciation {
  id              String   @id @default(uuid())
  moldId          String   @map("mold_id")
  productionOrderId String? @map("production_order_id")
  amount          Decimal  @db.Decimal(12, 2)
  depreciationDate DateTime @map("depreciation_date")
  createdAt       DateTime @default(now()) @map("created_at")
  mold            Mold     @relation(fields: [moldId], references: [id])

  @@map("mold_depreciations")
}

// ========== 工厂端 - BOM与材料 ==========

model BOMItem {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  materialName String  @map("material_name")
  materialType String  @map("material_type") // main / auxiliary
  unit        String
  unitPrice   Decimal  @db.Decimal(12, 4) @map("unit_price")
  quantity    Decimal  @db.Decimal(10, 2)
  lossRate    Decimal  @default(0) @db.Decimal(5, 4) @map("loss_rate") // 损耗率
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  product     Product  @relation(fields: [productId], references: [id])

  @@map("bom_items")
}

// ========== 工厂端 - 生产管理 ==========

model ProductionOrder {
  id          String   @id @default(uuid())
  orderNo     String   @unique @map("order_no")
  productId   String   @map("product_id")
  quantity    Int
  completedQty Int     @default(0) @map("completed_qty")
  status      String   @default("pending") // pending / in_progress / completed / cancelled
  startDate   DateTime @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  product     Product  @relation(fields: [productId], references: [id])
  costs       ProductionCost[]

  @@map("production_orders")
}

model ProductionCost {
  id                String   @id @default(uuid())
  productionOrderId String   @map("production_order_id")
  costType          String   @map("cost_type") // material / mold / labor / electricity / rent / other
  amount            Decimal  @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])

  @@map("production_costs")
}

model FactoryFixedExpense {
  id          String   @id @default(uuid())
  expenseType String   @map("expense_type") // rent / equipment_depreciation / utility / salary / management
  amount      Decimal  @db.Decimal(12, 2)
  expenseMonth String  @map("expense_month") // YYYY-MM
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("factory_fixed_expenses")
}

// ========== 仓库端 ==========

model Warehouse {
  id         String   @id @default(uuid())
  name       String
  code       String   @unique
  location   String?
  createdAt  DateTime @default(now()) @map("created_at")
  inventories Inventory[]

  @@map("warehouses")
}

model Inventory {
  id              String   @id @default(uuid())
  warehouseId     String   @map("warehouse_id")
  productId       String   @map("product_id")
  quantity        Int      @default(0)
  unitCost        Decimal  @db.Decimal(12, 4) @map("unit_cost") // 含全部生产成本的入库单价
  totalCost       Decimal  @db.Decimal(14, 2) @map("total_cost")
  updatedAt       DateTime @updatedAt @map("updated_at")
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, productId])
  @@map("inventories")
}

model WarehouseExpense {
  id          String   @id @default(uuid())
  expenseType String   @map("expense_type") // rent / packaging / loss / salary / management
  amount      Decimal  @db.Decimal(12, 2)
  expenseMonth String  @map("expense_month")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("warehouse_expenses")
}

// ========== 运营端 - 订单与收入 ==========

model Order {
  id            String   @id @default(uuid())
  orderNo       String   @unique @map("order_no")
  storeId       String   @map("store_id")
  productId     String   @map("product_id")
  platformOrderNo String? @map("platform_order_no")
  quantity      Int
  unitPrice     Decimal  @db.Decimal(10, 2) @map("unit_price")
  totalAmount   Decimal  @db.Decimal(12, 2) @map("total_amount")
  currency      String   @default("USD")
  orderDate     DateTime @map("order_date")
  status        String   @default("pending") // pending / shipped / delivered / refunded / cancelled
  store         Store    @relation(fields: [storeId], references: [id])
  product       Product  @relation(fields: [productId], references: [id])
  fees          OrderFee[]
  profits       OrderProfit?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("orders")
}

model OrderFee {
  id       String   @id @default(uuid())
  orderId  String   @map("order_id")
  feeType  String   @map("fee_type") // platform_commission / advertising / logistics / aftersales / other
  amount   Decimal  @db.Decimal(12, 2)
  notes    String?
  createdAt DateTime @default(now()) @map("created_at")
  order    Order    @relation(fields: [orderId], references: [id])

  @@map("order_fees")
}

model OrderProfit {
  id            String   @id @default(uuid())
  orderId       String   @unique @map("order_id")
  revenue       Decimal  @db.Decimal(12, 2)
  productCost   Decimal  @db.Decimal(12, 2) @map("product_cost")   // 生产成本
  warehouseCost Decimal  @db.Decimal(12, 2) @map("warehouse_cost") // 仓储分摊
  platformFee   Decimal  @db.Decimal(12, 2) @map("platform_fee")   // 平台佣金
  adFee         Decimal  @db.Decimal(12, 2) @map("ad_fee")         // 广告分摊
  logisticsFee  Decimal  @db.Decimal(12, 2) @map("logistics_fee")  // 物流费
  aftersalesFee Decimal  @db.Decimal(12, 2) @map("aftersales_fee") // 售后损耗
  netProfit     Decimal  @db.Decimal(12, 2) @map("net_profit")     // 净利润
  profitMargin  Decimal  @db.Decimal(5, 2) @map("profit_margin")   // 利润率%
  calculatedAt  DateTime @default(now()) @map("calculated_at")
  order         Order    @relation(fields: [orderId], references: [id])

  @@map("order_profits")
}

// ========== 运营端 - 广告管理 ==========

model AdCampaign {
  id            String   @id @default(uuid())
  storeId       String   @map("store_id")
  platformCampaignId String? @map("platform_campaign_id")
  campaignName  String   @map("campaign_name")
  campaignType  String   @map("campaign_type") // sp / sd / sa / info_feed / external
  spend         Decimal  @db.Decimal(12, 2) @default(0)
  impressions   Int      @default(0)
  clicks        Int      @default(0)
  orders        Int      @default(0)
  sales         Decimal  @db.Decimal(12, 2) @default(0)
  acos          Decimal? @db.Decimal(6, 4) // Advertising Cost of Sales
  startDate     DateTime @map("start_date")
  endDate       DateTime? @map("end_date")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  store         Store    @relation(fields: [storeId], references: [id])

  @@map("ad_campaigns")
}

// ========== 售后端 ==========

model AfterSales {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  type        String   // refund / return / exchange / complaint / repair / resend
  status      String   @default("pending") // pending / processing / completed
  refundAmount Decimal? @db.Decimal(12, 2) @map("refund_amount")
  logisticsFee  Decimal? @db.Decimal(12, 2) @map("logistics_fee")
  compensation  Decimal? @db.Decimal(12, 2)
  lossAmount    Decimal? @db.Decimal(12, 2) @map("loss_amount") // 货损金额
  reason      String?
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("after_sales")
}

// ========== 物流管理 ==========

model Logistics {
  id            String   @id @default(uuid())
  orderId       String   @map("order_id")
  trackingNo    String?  @map("tracking_no")
  carrier       String?  // 物流商
  stage         String   @default("first_mile") // first_mile / last_mile / overseas_warehouse
  fee           Decimal  @db.Decimal(12, 2) @default(0)
  status        String   @default("pending") // pending / in_transit / delivered / exception
  estimatedDelivery DateTime? @map("estimated_delivery")
  actualDelivery DateTime? @map("actual_delivery")
  exceptionNote String?  @map("exception_note")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("logistics")
}
