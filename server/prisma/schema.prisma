// ============================================================
// 博纳ERP Prisma Schema v3.0 - Cloudflare D1 (SQLite)
// ============================================================
// 改造说明:
//   - Decimal → Float（SQLite不支持Decimal，精度由应用层保证）
//   - Enum → String（SQLite不支持Enum，注释标注有效值）
//   - Json → String（SQLite不支持Json，应用层JSON.stringify/parse）
//   - 启用 driverAdapters preview feature 以支持 @prisma/adapter-d1
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// 一、组织与权限
// ============================================================

model Company {
  id             String   @id @default(uuid())
  name           String
  code           String   @unique
  address        String?
  contactPerson  String?  @map("contact_person")
  phone          String?
  email          String?
  currency       String   @default("CNY")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  departments Department[]
  users       User[]

  @@map("companies")
}

model Department {
  id        String   @id @default(uuid())
  name      String
  companyId String   @map("company_id")
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company      @relation(fields: [companyId], references: [id])
  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children Department[] @relation("DepartmentHierarchy")
  users    User[]

  @@map("departments")
}

// UserRole enum → String: BOSS | FACTORY_MANAGER | WAREHOUSE_MANAGER | OPERATOR | AFTERSALES | ADMIN | VIEWER
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  realName     String   @map("real_name")
  email        String?
  phone        String?
  role         String   @default("OPERATOR") // BOSS/FACTORY_MANAGER/WAREHOUSE_MANAGER/OPERATOR/AFTERSALES/ADMIN/VIEWER
  status       String   @default("active") // active / disabled
  departmentId String?  @map("department_id")
  companyId    String   @map("company_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  department Department? @relation(fields: [departmentId], references: [id])
  company    Company     @relation(fields: [companyId], references: [id])

  auditLogs                AuditLog[]
  productionOrdersCreated  ProductionOrder[]        @relation("PoCreatedBy")
  productionOrdersReleased ProductionOrder[]        @relation("PoReleasedBy")
  ledgerPosted             InventoryLedger[]        @relation("LedgerPostedBy")
  lotConsumed              MaterialLotConsumption[] @relation("LotConsumed")

  @@map("users")
}

// ============================================================
// 二、平台与店铺
// ============================================================

model Platform {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  apiBase   String?  @map("api_base")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")

  stores Store[]

  @@map("platforms")
}

model Store {
  id           String    @id @default(uuid())
  name         String
  storeId      String    @map("store_id")
  platformId   String    @map("platform_id")
  region       String    @default("北美")
  currency     String    @default("USD")
  taxMode      String    @default("excl")
  tokenInfo    String?   @map("token_info") // JSON字符串存储API授权信息
  storeType    String    @default("self") @map("store_type")
  syncEnabled  Boolean   @default(true) @map("sync_enabled")
  lastSyncedAt DateTime? @map("last_synced_at")
  status       String    @default("active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  platform      Platform       @relation(fields: [platformId], references: [id])
  storeProducts StoreProduct[]
  orders        Order[]
  adCampaigns   AdCampaign[]

  @@map("stores")
}

// ============================================================
// 三、产品与物料
// ============================================================

// MaterialType → String: RAW_MATERIAL | COMPONENT | SEMI_FINISHED | FINISHED_GOOD | CONSUMABLE | MOLD | SPARE_PART

model UnitOfMeasure {
  id          String   @id @default(uuid())
  code        String   @unique
  description String
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  products          Product[]
  inventoryLedger   InventoryLedger[]
  inventoryBalances InventoryBalance[]
  materialLots      MaterialLot[]
  finishedGoodLots  FinishedGoodLot[]          @relation("FgLotUom")
  bomLines          BillOfMaterialLine[]
  productionOrders  ProductionOrder[]          @relation("PoUom")
  poComponents      ProductionOrderComponent[] @relation("PoComponentUom")

  @@map("unit_of_measures")
}

model Product {
  id            String   @id @default(uuid())
  sku           String   @unique
  productNumber String?  @unique @map("product_number")
  name          String
  nameEn        String?  @map("name_en")
  description   String?
  materialType  String   @default("FINISHED_GOOD") @map("material_type") // RAW_MATERIAL/COMPONENT/SEMI_FINISHED/FINISHED_GOOD/CONSUMABLE/MOLD/SPARE_PART

  unitOfMeasureId String        @map("unit_of_measure_id")
  unitOfMeasure   UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id])

  category    String?
  brand       String?
  imageUrl    String?  @map("image_url")
  weight      Float?
  dimensions  String?  // JSON: { length, width, height, unit }
  customsCode String?  @map("customs_code")

  standardCost Float?  @map("standard_cost")
  currentCost  Float?  @map("current_cost")
  leadTimeDays Int?    @map("lead_time_days")

  status    String   @default("active") // active / inactive / obsolete
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  storeProducts StoreProduct[]
  orderItems    OrderItem[]
  molds         Mold[]

  bomsAsParent        BillOfMaterials[]    @relation("BomParent")
  bomLinesAsComponent BillOfMaterialLine[] @relation("BomComponent")

  productionOrders ProductionOrder[]          @relation("PoParent")
  poComponents     ProductionOrderComponent[] @relation("PoComponentMaterial")

  materialLots     MaterialLot[]
  finishedGoodLots FinishedGoodLot[] @relation("FgLotMaterial")

  inventoryLedger   InventoryLedger[]
  inventoryBalances InventoryBalance[]

  @@index([materialType])
  @@index([status])
  @@map("products")
}

model StoreProduct {
  id           String   @id @default(uuid())
  storeId      String   @map("store_id")
  productId    String   @map("product_id")
  storeSku     String?  @map("store_sku")
  asin         String?
  listingUrl   String?  @map("listing_url")
  currentPrice Float?   @map("current_price")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  store   Store   @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([storeId, productId])
  @@map("store_products")
}

// ============================================================
// 四、供应商
// ============================================================

model Supplier {
  id             String   @id @default(uuid())
  supplierNumber String   @unique @map("supplier_number")
  name           String
  contactPerson  String?  @map("contact_person")
  contactPhone   String?  @map("contact_phone")
  contactEmail   String?  @map("contact_email")
  address        String?
  paymentTerms   Int?     @map("payment_terms")
  currency       String   @default("CNY")
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  materialLots MaterialLot[] @relation("LotSupplier")

  @@index([status])
  @@map("suppliers")
}

// ============================================================
// 五、工厂端 - 模具管理
// ============================================================

model Mold {
  id                 String    @id @default(uuid())
  moldCode           String    @unique @map("mold_code")
  productId          String    @map("product_id")
  moldCost           Float     @map("mold_cost")
  lifespan           Int
  producedCount      Int       @default(0) @map("produced_count")
  depreciationMethod String    @default("per_unit") @map("depreciation_method")
  startDate          DateTime  @map("start_date")
  scrapDate          DateTime? @map("scrap_date")
  status             String    @default("active") // active / maintained / scrapped
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  product       Product            @relation(fields: [productId], references: [id])
  expenses      MoldExpense[]
  depreciations MoldDepreciation[]

  @@map("molds")
}

model MoldExpense {
  id          String   @id @default(uuid())
  moldId      String   @map("mold_id")
  type        String // repair / maintenance / modification
  amount      Float
  expenseDate DateTime @map("expense_date")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  mold Mold @relation(fields: [moldId], references: [id], onDelete: Cascade)

  @@map("mold_expenses")
}

model MoldDepreciation {
  id                String   @id @default(uuid())
  moldId            String   @map("mold_id")
  productionOrderId String?  @map("production_order_id")
  amount            Float
  depreciationDate  DateTime @map("depreciation_date")
  createdAt         DateTime @default(now()) @map("created_at")

  mold Mold @relation(fields: [moldId], references: [id], onDelete: Cascade)

  @@map("mold_depreciations")
}

// ============================================================
// 六、工厂端 - BOM
// ============================================================

// BOMStatus → String: DRAFT / ACTIVE / INACTIVE

model BillOfMaterials {
  id           String    @id @default(uuid())
  bomNumber    String    @unique @map("bom_number")
  productId    String    @map("product_id")
  product      Product   @relation("BomParent", fields: [productId], references: [id])
  version      Int       @default(1)
  status       String    @default("DRAFT") // DRAFT / ACTIVE / INACTIVE
  description  String?
  baseQuantity Float     @default(1) @map("base_quantity")
  createdById  String    @map("created_by_id")
  approvedAt   DateTime? @map("approved_at")
  activatedAt  DateTime? @map("activated_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  lines            BillOfMaterialLine[]
  productionOrders ProductionOrder[]

  @@unique([productId, version])
  @@index([productId, status])
  @@map("bill_of_materials")
}

model BillOfMaterialLine {
  id         String          @id @default(uuid())
  bomId      String          @map("bom_id")
  bom        BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  lineNumber Int             @map("line_number")

  materialId      String        @map("material_id")
  material        Product       @relation("BomComponent", fields: [materialId], references: [id])
  quantity        Float
  unitOfMeasureId String        @map("unit_of_measure_id")
  unitOfMeasure   UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id])
  scrapPercent    Float         @default(0) @map("scrap_percent")
  isKeyMaterial   Boolean       @default(false) @map("is_key_material")
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")

  @@unique([bomId, lineNumber])
  @@map("bill_of_material_lines")
}

// ============================================================
// 七、工厂端 - 工作中心 & 生产工单
// ============================================================

// WorkCenterType → String: MACHINE / ASSEMBLY / INSPECTION / PACKAGING / MANUAL

model WorkCenter {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  description    String?
  type           String   // MACHINE / ASSEMBLY / INSPECTION / PACKAGING / MANUAL
  costPerHour    Float?   @map("cost_per_hour")
  capacityPerDay Float?   @map("capacity_per_day")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  productionOperations ProductionOrderOperation[]

  @@map("work_centers")
}

// ProductionOrderStatus → String: DRAFT / RELEASED / IN_PROGRESS / COMPLETED / CLOSED / CANCELLED

model ProductionOrder {
  id          String   @id @default(uuid())
  orderNumber String   @unique @map("order_number")
  status      String   @default("DRAFT") // DRAFT/RELEASED/IN_PROGRESS/COMPLETED/CLOSED/CANCELLED

  productId       String        @map("product_id")
  product         Product       @relation("PoParent", fields: [productId], references: [id])
  quantity        Float
  unitOfMeasureId String        @map("unit_of_measure_id")
  unitOfMeasure   UnitOfMeasure @relation("PoUom", fields: [unitOfMeasureId], references: [id])

  bomId String          @map("bom_id")
  bom   BillOfMaterials @relation(fields: [bomId], references: [id])

  plannedStartDate DateTime? @map("planned_start_date")
  plannedEndDate   DateTime? @map("planned_end_date")
  releasedAt       DateTime? @map("released_at")
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  closedAt         DateTime? @map("closed_at")

  completedQuantity Float @default(0) @map("completed_quantity")
  scrappedQuantity  Float @default(0) @map("scrapped_quantity")

  createdById  String  @map("created_by_id")
  createdBy    User    @relation("PoCreatedBy", fields: [createdById], references: [id])
  releasedById String? @map("released_by_id")
  releasedBy   User?   @relation("PoReleasedBy", fields: [releasedById], references: [id])

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  components       ProductionOrderComponent[]
  operations       ProductionOrderOperation[]
  finishedGoodLots FinishedGoodLot[]
  costs            ProductionCost[]

  @@index([status])
  @@index([productId])
  @@map("production_orders")
}

model ProductionOrderComponent {
  id                String          @id @default(uuid())
  productionOrderId String          @map("production_order_id")
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  lineNumber        Int             @map("line_number")

  materialId      String        @map("material_id")
  material        Product       @relation("PoComponentMaterial", fields: [materialId], references: [id])
  unitOfMeasureId String        @map("unit_of_measure_id")
  unitOfMeasure   UnitOfMeasure @relation("PoComponentUom", fields: [unitOfMeasureId], references: [id])

  plannedQuantity  Float @map("planned_quantity")
  issuedQuantity   Float @default(0) @map("issued_quantity")
  scrappedQuantity Float @default(0) @map("scrapped_quantity")

  notes String?

  lotConsumptions MaterialLotConsumption[]

  @@unique([productionOrderId, lineNumber])
  @@index([materialId])
  @@map("production_order_components")
}

// OperationStatus → String: PENDING / IN_PROGRESS / CONFIRMED / SKIPPED

model ProductionOrderOperation {
  id                String          @id @default(uuid())
  productionOrderId String          @map("production_order_id")
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  sequence          Int

  name         String
  workCenterId String     @map("work_center_id")
  workCenter   WorkCenter @relation(fields: [workCenterId], references: [id])

  plannedHours Float @default(0) @map("planned_hours")
  actualHours  Float @default(0) @map("actual_hours")
  laborCost    Float @default(0) @map("labor_cost")

  status      String    @default("PENDING") // PENDING/IN_PROGRESS/CONFIRMED/SKIPPED
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  notes       String?

  @@unique([productionOrderId, sequence])
  @@map("production_order_operations")
}

model ProductionCost {
  id                String   @id @default(uuid())
  productionOrderId String   @map("production_order_id")
  costType          String   @map("cost_type") // material / mold / labor / electricity / equipment / management / other
  amount            Float
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@map("production_costs")
}

model FactoryFixedExpense {
  id           String   @id @default(uuid())
  expenseType  String   @map("expense_type") // rent / equipment_depreciation / utility / salary / management / other
  amount       Float
  expenseMonth String   @map("expense_month")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([expenseMonth])
  @@map("factory_fixed_expenses")
}

// ============================================================
// 八、仓库端 - 不可变库存账本系统
// ============================================================

model Warehouse {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  address   String?
  city      String?
  country   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  storageLocations StorageLocation[]
  orders           Order[]

  @@map("warehouses")
}

model StorageLocation {
  id          String    @id @default(uuid())
  code        String
  description String?
  warehouseId String    @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  inventoryLedger   InventoryLedger[]
  inventoryBalances InventoryBalance[]
  materialLots      MaterialLot[]
  finishedGoodLots  FinishedGoodLot[]  @relation("FgLotLocation")

  @@unique([warehouseId, code])
  @@map("storage_locations")
}

// InventoryMovementType → String: GOODS_RECEIPT/PURCHASE_RECEIPT/MATERIAL_ISSUE/RETURN_TO_STOCK/STOCK_TRANSFER/SHIPMENT/AFTERSALES_RETURN/ADJUSTMENT/INITIAL

model InventoryLedger {
  id           String   @id @default(uuid())
  movementType String   @map("movement_type") // GOODS_RECEIPT/PURCHASE_RECEIPT/MATERIAL_ISSUE/RETURN_TO_STOCK/STOCK_TRANSFER/SHIPMENT/AFTERSALES_RETURN/ADJUSTMENT/INITIAL

  productId         String          @map("product_id")
  product           Product         @relation(fields: [productId], references: [id])
  storageLocationId String          @map("storage_location_id")
  storageLocation   StorageLocation @relation(fields: [storageLocationId], references: [id])

  quantity        Float
  unitOfMeasureId String        @map("unit_of_measure_id")
  unitOfMeasure   UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id])
  unitCost        Float?        @map("unit_cost")

  referenceType String @map("reference_type")
  referenceId   String @map("reference_id")

  postedById String   @map("posted_by_id")
  postedBy   User     @relation("LedgerPostedBy", fields: [postedById], references: [id])
  postedAt   DateTime @default(now()) @map("posted_at")

  notes String?

  @@index([productId])
  @@index([storageLocationId])
  @@index([productId, storageLocationId])
  @@index([referenceType, referenceId])
  @@index([postedAt])
  @@map("inventory_ledgers")
}

model InventoryBalance {
  id String @id @default(uuid())

  productId         String          @map("product_id")
  product           Product         @relation(fields: [productId], references: [id])
  storageLocationId String          @map("storage_location_id")
  storageLocation   StorageLocation @relation(fields: [storageLocationId], references: [id])

  quantityOnHand  Float        @default(0) @map("quantity_on_hand")
  totalCost       Float        @default(0) @map("total_cost")
  unitOfMeasureId String       @map("unit_of_measure_id")
  unitOfMeasure   UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id])

  lastMovementAt DateTime? @map("last_movement_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([productId, storageLocationId])
  @@index([productId])
  @@index([storageLocationId])
  @@map("inventory_balances")
}

model MaterialLot {
  id        String @id @default(uuid())
  lotNumber String @unique @map("lot_number")

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  quantityReceived  Float         @map("quantity_received")
  quantityRemaining Float         @map("quantity_remaining")
  unitOfMeasureId   String        @map("unit_of_measure_id")
  unitOfMeasure     UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id])
  unitCost          Float         @map("unit_cost")

  storageLocationId String          @map("storage_location_id")
  storageLocation   StorageLocation @relation(fields: [storageLocationId], references: [id])

  sourceType  String    @map("source_type")
  sourceRefId String    @map("source_ref_id")
  supplierId  String?   @map("supplier_id")
  supplier    Supplier? @relation("LotSupplier", fields: [supplierId], references: [id])

  receivedAt DateTime @map("received_at")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  consumptions MaterialLotConsumption[]

  @@index([productId, quantityRemaining])
  @@index([productId, storageLocationId, quantityRemaining])
  @@map("material_lots")
}

model MaterialLotConsumption {
  id                         String                   @id @default(uuid())
  productionOrderComponentId String                   @map("production_order_component_id")
  productionOrderComponent   ProductionOrderComponent @relation(fields: [productionOrderComponentId], references: [id], onDelete: Cascade)
  materialLotId              String                   @map("material_lot_id")
  materialLot                MaterialLot              @relation(fields: [materialLotId], references: [id])
  quantity                   Float
  postedById                 String                   @map("posted_by_id")
  postedBy                   User                     @relation("LotConsumed", fields: [postedById], references: [id])
  postedAt                   DateTime                 @default(now()) @map("posted_at")
  notes                      String?

  @@index([productionOrderComponentId])
  @@index([materialLotId])
  @@map("material_lot_consumptions")
}

model FinishedGoodLot {
  id        String @id @default(uuid())
  lotNumber String @unique @map("lot_number")

  productId         String          @map("product_id")
  product           Product         @relation("FgLotMaterial", fields: [productId], references: [id])
  productionOrderId String          @map("production_order_id")
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])

  quantity          Float
  unitOfMeasureId   String          @map("unit_of_measure_id")
  unitOfMeasure     UnitOfMeasure   @relation("FgLotUom", fields: [unitOfMeasureId], references: [id])
  storageLocationId String          @map("storage_location_id")
  storageLocation   StorageLocation @relation("FgLotLocation", fields: [storageLocationId], references: [id])

  receivedAt DateTime @default(now()) @map("received_at")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([productionOrderId])
  @@index([productId])
  @@map("finished_good_lots")
}

// ============================================================
// 九、仓库端 - 仓储费用
// ============================================================

model WarehouseExpense {
  id           String   @id @default(uuid())
  warehouseId  String?  @map("warehouse_id")
  expenseType  String   @map("expense_type") // rent / packaging / loss / salary / management / other
  amount       Float
  expenseMonth String   @map("expense_month")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([expenseMonth])
  @@map("warehouse_expenses")
}

// ============================================================
// 十、运营端 - 订单与利润
// ============================================================

// OrderStatus → String: PENDING_REVIEW / PENDING_SHIP / SHIPPED / DELIVERED / CANCELLED / ABNORMAL
// PaymentStatus → String: PAID / UNPAID / REFUNDED / PARTIAL

model Order {
  id              String  @id @default(uuid())
  orderNumber     String  @unique @map("order_number")
  storeId         String  @map("store_id")
  platformOrderId String? @map("platform_order_id")

  customerName  String? @map("customer_name")
  customerEmail String? @map("customer_email")
  country       String

  currency       String  @default("USD")
  shippingAmount Float   @default(0) @map("shipping_amount")
  taxAmount      Float   @default(0) @map("tax_amount")
  totalAmount    Float   @map("total_amount")

  status         String @default("PENDING_REVIEW") // PENDING_REVIEW/PENDING_SHIP/SHIPPED/DELIVERED/CANCELLED/ABNORMAL
  paymentStatus  String @default("PAID") @map("payment_status") // PAID/UNPAID/REFUNDED/PARTIAL
  shippingStatus String? @map("shipping_status")

  warehouseId String?    @map("warehouse_id")
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  orderedAt   DateTime  @map("ordered_at")
  shippedAt   DateTime? @map("shipped_at")
  deliveredAt DateTime? @map("delivered_at")

  labels       String?  // JSON字符串: 订单标签
  internalNote String?  @map("internal_note")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  store     Store        @relation(fields: [storeId], references: [id])
  items     OrderItem[]
  logistics Logistics?
  refunds   AfterSales[]
  finance   OrderProfit?
  fees      OrderFee[]

  @@index([storeId])
  @@index([status])
  @@index([orderedAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  productId   String   @map("product_id")
  quantity    Int
  unitPrice   Float    @map("unit_price")
  totalAmount Float    @map("total_amount")
  createdAt   DateTime @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model OrderFee {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  feeType   String   @map("fee_type") // platform_commission / advertising / logistics / aftersales / other
  amount    Float
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_fees")
}

model OrderProfit {
  id      String @id @default(uuid())
  orderId String @unique @map("order_id")

  salesAmount  Float @map("sales_amount")
  refundAmount Float @default(0) @map("refund_amount")

  productCost   Float @default(0) @map("product_cost")
  warehouseCost Float @default(0) @map("warehouse_cost")
  platformFee   Float @default(0) @map("platform_fee")
  adFee         Float @default(0) @map("ad_fee")
  logisticsFee  Float @default(0) @map("logistics_fee")
  aftersalesFee Float @default(0) @map("aftersales_fee")
  taxFee        Float @default(0) @map("tax_fee")

  grossProfit  Float @default(0) @map("gross_profit")
  netProfit    Float @default(0) @map("net_profit")
  profitMargin Float @default(0) @map("profit_margin")

  calculatedAt DateTime @default(now()) @map("calculated_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_profits")
}

// ============================================================
// 十一、运营端 - 广告管理
// ============================================================

model AdCampaign {
  id                 String    @id @default(uuid())
  storeId            String    @map("store_id")
  platformCampaignId String?   @map("platform_campaign_id")
  campaignName       String    @map("campaign_name")
  campaignType       String    @map("campaign_type") // sp / sd / sa / info_feed / external
  spend              Float     @default(0)
  impressions        Int       @default(0)
  clicks             Int       @default(0)
  orders             Int       @default(0)
  sales              Float     @default(0)
  acos               Float?
  roas               Float?
  startDate          DateTime  @map("start_date")
  endDate            DateTime? @map("end_date")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([startDate])
  @@map("ad_campaigns")
}

// ============================================================
// 十二、售后端
// ============================================================

// AfterSalesType → String: REFUND / RETURN_REFUND / EXCHANGE / COMPLAINT / REPAIR / RESEND
// AfterSalesStatus → String: PENDING / PROCESSING / COMPLETED / REJECTED

model AfterSales {
  id      String   @id @default(uuid())
  orderId String   @map("order_id")
  type    String   @default("REFUND") // REFUND/RETURN_REFUND/EXCHANGE/COMPLAINT/REPAIR/RESEND
  status  String   @default("PENDING") // PENDING/PROCESSING/COMPLETED/REJECTED

  refundAmount Float? @map("refund_amount")
  logisticsFee Float? @map("logistics_fee")
  compensation Float?
  lossAmount   Float? @map("loss_amount")

  reason     String?
  resolution String?
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@map("after_sales")
}

// ============================================================
// 十三、物流管理
// ============================================================

// LogisticsStage → String: FIRST_MILE / DOMESTIC_WAREHOUSE / INTERNATIONAL / LAST_MILE / OVERSEAS_WAREHOUSE
// LogisticsStatus → String: PENDING / IN_TRANSIT / DELIVERED / EXCEPTION / RETURNED

model Logistics {
  id             String   @id @default(uuid())
  orderId        String   @unique @map("order_id")
  trackingNumber String?  @map("tracking_number")
  carrier        String?
  channel        String?
  stage          String   @default("FIRST_MILE") // FIRST_MILE/DOMESTIC_WAREHOUSE/INTERNATIONAL/LAST_MILE/OVERSEAS_WAREHOUSE
  status         String   @default("PENDING") // PENDING/IN_TRANSIT/DELIVERED/EXCEPTION/RETURNED

  firstMileFee     Float @default(0) @map("first_mile_fee")
  internationalFee Float @default(0) @map("international_fee")
  lastMileFee      Float @default(0) @map("last_mile_fee")
  totalFee         Float @default(0) @map("total_fee")

  estimatedDelivery DateTime? @map("estimated_delivery")
  actualDelivery    DateTime? @map("actual_delivery")
  exceptionNote     String?   @map("exception_note")

  shippedAt   DateTime? @map("shipped_at")
  deliveredAt DateTime? @map("delivered_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([carrier])
  @@map("logistics")
}

// ============================================================
// 十四、审计日志
// ============================================================

model AuditLog {
  id          String   @id @default(uuid())
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  action      String // CREATE / UPDATE / DELETE / APPROVE / REJECT / POST ...
  actorId     String   @map("actor_id")
  actor       User     @relation(fields: [actorId], references: [id])
  beforeState String?  @map("before_state") // JSON字符串
  afterState  String?  @map("after_state")  // JSON字符串
  metadata    String?  // JSON字符串
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}
