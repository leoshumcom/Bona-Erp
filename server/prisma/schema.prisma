// ============================================================
// 博纳ERP Prisma Schema v2.0
// 整合来源:
//   - factoryos-erp: 不可变库存账本、BOM版本化、FIFO批次、工单工序
//   - SHOPERP-C: 多店铺电商、订单拆行、售后退款、利润核算
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 一、组织与权限
// ============================================================

model Company {
  id             String   @id @default(uuid())
  name           String
  code           String   @unique
  address        String?
  contactPerson  String?  @map("contact_person")
  phone          String?
  email          String?
  currency       String   @default("CNY")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  departments Department[]
  users       User[]

  @@map("companies")
}

model Department {
  id        String   @id @default(uuid())
  name      String
  companyId String   @map("company_id")
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company      @relation(fields: [companyId], references: [id])
  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children Department[] @relation("DepartmentHierarchy")
  users    User[]

  @@map("departments")
}

enum UserRole {
  BOSS // 老板 - 全盘查看
  FACTORY_MANAGER // 工厂经理
  WAREHOUSE_MANAGER // 仓库经理
  OPERATOR // 运营
  AFTERSALES // 售后
  ADMIN // 系统管理员
  VIEWER // 只读
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  realName     String   @map("real_name")
  email        String?
  phone        String?
  role         UserRole @default(OPERATOR)
  status       String   @default("active") // active / disabled
  departmentId String?  @map("department_id")
  companyId    String   @map("company_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  department Department? @relation(fields: [departmentId], references: [id])
  company    Company     @relation(fields: [companyId], references: [id])

  // 操作审计
  auditLogs                AuditLog[]
  // 生产操作
  productionOrdersCreated  ProductionOrder[]        @relation("PoCreatedBy")
  productionOrdersReleased ProductionOrder[]        @relation("PoReleasedBy")
  // 库存操作
  ledgerPosted             InventoryLedger[]        @relation("LedgerPostedBy")
  lotConsumed              MaterialLotConsumption[] @relation("LotConsumed")

  @@map("users")
}

// ============================================================
// 二、平台与店铺
// ============================================================

model Platform {
  id        String   @id @default(uuid())
  name      String   @unique // Amazon / TikTokShop / Temu / Shopee / Shopify / AliExpress
  code      String   @unique
  apiBase   String?  @map("api_base")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")

  stores Store[]

  @@map("platforms")
}

model Store {
  id           String    @id @default(uuid())
  name         String
  storeId      String    @map("store_id") // 平台店铺ID
  platformId   String    @map("platform_id")
  region       String    @default("北美") // 北美 / 欧盟 / 英国 / 亚太 / 拉美
  currency     String    @default("USD")
  taxMode      String    @default("excl") // incl(含税) / excl(不含税)
  tokenInfo    Json?     @map("token_info") // API授权信息(加密存储)
  storeType    String    @default("self") @map("store_type") // self / managed
  syncEnabled  Boolean   @default(true) @map("sync_enabled")
  lastSyncedAt DateTime? @map("last_synced_at")
  status       String    @default("active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  platform      Platform       @relation(fields: [platformId], references: [id])
  storeProducts StoreProduct[]
  orders        Order[]
  adCampaigns   AdCampaign[]

  @@map("stores")
}

// ============================================================
// 三、产品与物料（统一 Product = Material 概念）
// ============================================================

enum MaterialType {
  RAW_MATERIAL // 原材料（LED灯珠、散热器、透镜...）
  COMPONENT // 组件
  SEMI_FINISHED // 半成品
  FINISHED_GOOD // 成品（可销售SKU）
  CONSUMABLE // 耗材
  MOLD // 模具
  SPARE_PART // 备件
}

model UnitOfMeasure {
  id          String   @id @default(uuid())
  code        String   @unique // pcs / kg / m / set / box
  description String
  category    String? // weight / length / count / volume
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  products          Product[]
  inventoryLedger   InventoryLedger[]
  inventoryBalances InventoryBalance[]
  materialLots      MaterialLot[]
  finishedGoodLots  FinishedGoodLot[]          @relation("FgLotUom")
  bomLines          BillOfMaterialLine[]
  productionOrders  ProductionOrder[]          @relation("PoUom")
  poComponents      ProductionOrderComponent[] @relation("PoComponentUom")

  @@map("unit_of_measures")
}

model Product {
  id            String       @id @default(uuid())
  sku           String       @unique
  productNumber String?      @unique @map("product_number") // 产品编号(与SKU区分)
  name          String
  nameEn        String?      @map("name_en")
  description   String?
  materialType  MaterialType @default(FINISHED_GOOD) @map("material_type")

  // 单位
  unitOfMeasureId String        @map("unit_of_measure_id")
  unitOfMeasure   UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id])

  // 规格与属性
  category    String?
  brand       String?
  imageUrl    String?  @map("image_url")
  weight      Decimal? @db.Decimal(10, 3)
  dimensions  Json? // { length, width, height, unit: "cm" }
  customsCode String?  @map("customs_code") // 海关编码

  // 成本与定价（工厂端）
  standardCost Decimal? @map("standard_cost") @db.Decimal(14, 4)
  currentCost  Decimal? @map("current_cost") @db.Decimal(14, 4)
  leadTimeDays Int?     @map("lead_time_days") // 采购/生产周期

  // 状态
  status    String   @default("active") // active / inactive / obsolete
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 关联
  storeProducts StoreProduct[]
  orderItems    OrderItem[]
  molds         Mold[]

  // BOM关系
  bomsAsParent        BillOfMaterials[]    @relation("BomParent")
  bomLinesAsComponent BillOfMaterialLine[] @relation("BomComponent")

  // 生产
  productionOrders ProductionOrder[]          @relation("PoParent")
  poComponents     ProductionOrderComponent[] @relation("PoComponentMaterial")

  // 批次
  materialLots     MaterialLot[]
  finishedGoodLots FinishedGoodLot[] @relation("FgLotMaterial")

  // 库存
  inventoryLedger   InventoryLedger[]
  inventoryBalances InventoryBalance[]

  @@index([materialType])
  @@index([status])
  @@map("products")
}

model StoreProduct {
  id           String   @id @default(uuid())
  storeId      String   @map("store_id")
  productId    String   @map("product_id")
  storeSku     String?  @map("store_sku")
  asin         String?
  listingUrl   String?  @map("listing_url")
  currentPrice Decimal? @map("current_price") @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  store   Store   @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([storeId, productId])
  @@map("store_products")
}

// ============================================================
// 四、供应商
// ============================================================

model Supplier {
  id             String   @id @default(uuid())
  supplierNumber String   @unique @map("supplier_number")
  name           String
  contactPerson  String?  @map("contact_person")
  contactPhone   String?  @map("contact_phone")
  contactEmail   String?  @map("contact_email")
  address        String?
  paymentTerms   Int?     @map("payment_terms") // 付款周期(天)
  currency       String   @default("CNY")
  status         String   @default("active") // active / inactive
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  materialLots MaterialLot[] @relation("LotSupplier")

  @@index([status])
  @@map("suppliers")
}

// ============================================================
// 五、工厂端 - 模具管理
// ============================================================

model Mold {
  id                 String    @id @default(uuid())
  moldCode           String    @unique @map("mold_code")
  productId          String    @map("product_id")
  moldCost           Decimal   @map("mold_cost") @db.Decimal(14, 2)
  lifespan           Int // 计划使用寿命(次)
  producedCount      Int       @default(0) @map("produced_count") // 已生产次数
  depreciationMethod String    @default("per_unit") @map("depreciation_method") // per_unit / per_month
  startDate          DateTime  @map("start_date")
  scrapDate          DateTime? @map("scrap_date")
  status             String    @default("active") // active / maintained / scrapped
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  product       Product            @relation(fields: [productId], references: [id])
  expenses      MoldExpense[]
  depreciations MoldDepreciation[]

  @@map("molds")
}

model MoldExpense {
  id          String   @id @default(uuid())
  moldId      String   @map("mold_id")
  type        String // repair / maintenance / modification
  amount      Decimal  @db.Decimal(14, 2)
  expenseDate DateTime @map("expense_date")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  mold Mold @relation(fields: [moldId], references: [id], onDelete: Cascade)

  @@map("mold_expenses")
}

model MoldDepreciation {
  id                String   @id @default(uuid())
  moldId            String   @map("mold_id")
  productionOrderId String?  @map("production_order_id")
  amount            Decimal  @db.Decimal(14, 4) // 单件分摊金额 = moldCost / lifespan
  depreciationDate  DateTime @map("depreciation_date")
  createdAt         DateTime @default(now()) @map("created_at")

  mold Mold @relation(fields: [moldId], references: [id], onDelete: Cascade)

  @@map("mold_depreciations")
}

// ============================================================
// 六、工厂端 - BOM（版本化物料清单）
// ============================================================

enum BOMStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

model BillOfMaterials {
  id           String    @id @default(uuid())
  bomNumber    String    @unique @map("bom_number")
  productId    String    @map("product_id")
  product      Product   @relation("BomParent", fields: [productId], references: [id])
  version      Int       @default(1)
  status       BOMStatus @default(DRAFT)
  description  String?
  baseQuantity Decimal   @default(1) @map("base_quantity") @db.Decimal(14, 4) // 基础生产数量
  createdById  String    @map("created_by_id")
  approvedAt   DateTime? @map("approved_at")
  activatedAt  DateTime? @map("activated_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  lines            BillOfMaterialLine[]
  productionOrders ProductionOrder[]

  @@unique([productId, version])
  @@index([productId, status])
  @@map("bill_of_materials")
}

model BillOfMaterialLine {
  id         String          @id @default(uuid())
  bomId      String          @map("bom_id")
  bom        BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  lineNumber Int             @map("line_number")

  // 子物料
  materialId      String        @map("material_id")
  material        Product       @relation("BomComponent", fields: [materialId], references: [id])
  quantity        Decimal       @db.Decimal(14, 4) // 用量
  unitOfMeasureId String        @map("unit_of_measure_id")
  unitOfMeasure   UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id])
  scrapPercent    Decimal       @default(0) @map("scrap_percent") @db.Decimal(5, 2) // 损耗率%
  isKeyMaterial   Boolean       @default(false) @map("is_key_material") // 关键物料标记
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")

  @@unique([bomId, lineNumber])
  @@map("bill_of_material_lines")
}

// ============================================================
// 七、工厂端 - 工作中心 & 生产工单
// ============================================================

enum WorkCenterType {
  MACHINE // 机加工
  ASSEMBLY // 装配线
  INSPECTION // 质检
  PACKAGING // 包装
  MANUAL // 手工作业
}

model WorkCenter {
  id             String         @id @default(uuid())
  code           String         @unique
  name           String
  description    String?
  type           WorkCenterType
  costPerHour    Decimal?       @map("cost_per_hour") @db.Decimal(12, 4) // 工时费率
  capacityPerDay Decimal?       @map("capacity_per_day") @db.Decimal(8, 2) // 日产能
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  productionOperations ProductionOrderOperation[]

  @@map("work_centers")
}

enum ProductionOrderStatus {
  DRAFT // 草稿
  RELEASED // 已下达
  IN_PROGRESS // 生产中
  COMPLETED // 已完成
  CLOSED // 已关闭
  CANCELLED // 已取消
}

model ProductionOrder {
  id          String                @id @default(uuid())
  orderNumber String                @unique @map("order_number")
  status      ProductionOrderStatus @default(DRAFT)

  productId       String        @map("product_id")
  product         Product       @relation("PoParent", fields: [productId], references: [id])
  quantity        Decimal       @db.Decimal(14, 4)
  unitOfMeasureId String        @map("unit_of_measure_id")
  unitOfMeasure   UnitOfMeasure @relation("PoUom", fields: [unitOfMeasureId], references: [id])

  // 关联BOM和工艺
  bomId String          @map("bom_id")
  bom   BillOfMaterials @relation(fields: [bomId], references: [id])

  // 计划时间
  plannedStartDate DateTime? @map("planned_start_date")
  plannedEndDate   DateTime? @map("planned_end_date")
  releasedAt       DateTime? @map("released_at")
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  closedAt         DateTime? @map("closed_at")

  // 产出
  completedQuantity Decimal @default(0) @map("completed_quantity") @db.Decimal(14, 4)
  scrappedQuantity  Decimal @default(0) @map("scrapped_quantity") @db.Decimal(14, 4)

  // 操作员
  createdById  String  @map("created_by_id")
  createdBy    User    @relation("PoCreatedBy", fields: [createdById], references: [id])
  releasedById String? @map("released_by_id")
  releasedBy   User?   @relation("PoReleasedBy", fields: [releasedById], references: [id])

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 关联
  components       ProductionOrderComponent[]
  operations       ProductionOrderOperation[]
  finishedGoodLots FinishedGoodLot[]
  costs            ProductionCost[]

  @@index([status])
  @@index([productId])
  @@map("production_orders")
}

model ProductionOrderComponent {
  id                String          @id @default(uuid())
  productionOrderId String          @map("production_order_id")
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  lineNumber        Int             @map("line_number")

  materialId      String        @map("material_id")
  material        Product       @relation("PoComponentMaterial", fields: [materialId], references: [id])
  unitOfMeasureId String        @map("unit_of_measure_id")
  unitOfMeasure   UnitOfMeasure @relation("PoComponentUom", fields: [unitOfMeasureId], references: [id])

  plannedQuantity  Decimal @map("planned_quantity") @db.Decimal(16, 4)
  issuedQuantity   Decimal @default(0) @map("issued_quantity") @db.Decimal(16, 4)
  scrappedQuantity Decimal @default(0) @map("scrapped_quantity") @db.Decimal(16, 4)

  notes String?

  // FIFO消耗记录
  lotConsumptions MaterialLotConsumption[]

  @@unique([productionOrderId, lineNumber])
  @@index([materialId])
  @@map("production_order_components")
}

enum OperationStatus {
  PENDING
  IN_PROGRESS
  CONFIRMED
  SKIPPED
}

model ProductionOrderOperation {
  id                String          @id @default(uuid())
  productionOrderId String          @map("production_order_id")
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  sequence          Int

  name         String
  workCenterId String     @map("work_center_id")
  workCenter   WorkCenter @relation(fields: [workCenterId], references: [id])

  plannedHours Decimal @default(0) @map("planned_hours") @db.Decimal(8, 4)
  actualHours  Decimal @default(0) @map("actual_hours") @db.Decimal(8, 4)
  laborCost    Decimal @default(0) @map("labor_cost") @db.Decimal(14, 4)

  status      OperationStatus @default(PENDING)
  startedAt   DateTime?       @map("started_at")
  completedAt DateTime?       @map("completed_at")
  notes       String?

  @@unique([productionOrderId, sequence])
  @@map("production_order_operations")
}

model ProductionCost {
  id                String   @id @default(uuid())
  productionOrderId String   @map("production_order_id")
  costType          String   @map("cost_type") // material / mold / labor / electricity / equipment / management / other
  amount            Decimal  @db.Decimal(14, 4)
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@map("production_costs")
}

model FactoryFixedExpense {
  id           String   @id @default(uuid())
  expenseType  String   @map("expense_type") // rent / equipment_depreciation / utility / salary / management / other
  amount       Decimal  @db.Decimal(14, 2)
  expenseMonth String   @map("expense_month") // YYYY-MM
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([expenseMonth])
  @@map("factory_fixed_expenses")
}

// ============================================================
// 八、仓库端 - 不可变库存账本系统
// ============================================================

model Warehouse {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  address   String?
  city      String?
  country   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  storageLocations StorageLocation[]
  orders           Order[]

  @@map("warehouses")
}

model StorageLocation {
  id          String    @id @default(uuid())
  code        String
  description String?
  warehouseId String    @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  inventoryLedger   InventoryLedger[]
  inventoryBalances InventoryBalance[]
  materialLots      MaterialLot[]
  finishedGoodLots  FinishedGoodLot[]  @relation("FgLotLocation")

  @@unique([warehouseId, code])
  @@map("storage_locations")
}

// 库存变动类型
enum InventoryMovementType {
  GOODS_RECEIPT // 生产入库
  PURCHASE_RECEIPT // 采购入库
  MATERIAL_ISSUE // 生产领料
  RETURN_TO_STOCK // 退料
  STOCK_TRANSFER // 调拨
  SHIPMENT // 销售出库
  AFTERSALES_RETURN // 售后退货
  ADJUSTMENT // 盘点调整
  INITIAL // 期初数据
}

// ▸▸ 不可变库存账本（每条记录不可修改，余额由 Balance 聚合计算）
model InventoryLedger {
  id           String                @id @default(uuid())
  movementType InventoryMovementType @map("movement_type")

  productId         String          @map("product_id")
  product           Product         @relation(fields: [productId], references: [id])
  storageLocationId String          @map("storage_location_id")
  storageLocation   StorageLocation @relation(fields: [storageLocationId], references: [id])

  quantity        Decimal       @db.Decimal(14, 4) // 正=入库 负=出库
  unitOfMeasureId String        @map("unit_of_measure_id")
  unitOfMeasure   UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id])
  unitCost        Decimal?      @map("unit_cost") @db.Decimal(14, 4) // 单位成本（入库时）

  // 业务追溯
  referenceType String @map("reference_type") // ProductionOrder / PurchaseOrder / Order / AfterSales
  referenceId   String @map("reference_id")

  // 操作人
  postedById String   @map("posted_by_id")
  postedBy   User     @relation("LedgerPostedBy", fields: [postedById], references: [id])
  postedAt   DateTime @default(now()) @map("posted_at")

  notes String?

  @@index([productId])
  @@index([storageLocationId])
  @@index([productId, storageLocationId])
  @@index([referenceType, referenceId])
  @@index([postedAt])
  @@map("inventory_ledgers")
}

// ▸▸ 库存余额快照（由 Ledger 聚合维护）
model InventoryBalance {
  id String @id @default(uuid())

  productId         String          @map("product_id")
  product           Product         @relation(fields: [productId], references: [id])
  storageLocationId String          @map("storage_location_id")
  storageLocation   StorageLocation @relation(fields: [storageLocationId], references: [id])

  quantityOnHand  Decimal       @default(0) @map("quantity_on_hand") @db.Decimal(16, 4)
  totalCost       Decimal       @default(0) @map("total_cost") @db.Decimal(16, 4) // 总成本
  unitOfMeasureId String        @map("unit_of_measure_id")
  unitOfMeasure   UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id])

  lastMovementAt DateTime? @map("last_movement_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([productId, storageLocationId])
  @@index([productId])
  @@index([storageLocationId])
  @@map("inventory_balances")
}

// ▸▸ FIFO 物料批次
model MaterialLot {
  id        String @id @default(uuid())
  lotNumber String @unique @map("lot_number")

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  quantityReceived  Decimal       @map("quantity_received") @db.Decimal(16, 4)
  quantityRemaining Decimal       @map("quantity_remaining") @db.Decimal(16, 4)
  unitOfMeasureId   String        @map("unit_of_measure_id")
  unitOfMeasure     UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id])
  unitCost          Decimal       @map("unit_cost") @db.Decimal(14, 4)

  storageLocationId String          @map("storage_location_id")
  storageLocation   StorageLocation @relation(fields: [storageLocationId], references: [id])

  // 来源追溯
  sourceType  String    @map("source_type") // ProductionOrder / PurchaseOrder / InitialStock
  sourceRefId String    @map("source_ref_id")
  supplierId  String?   @map("supplier_id")
  supplier    Supplier? @relation("LotSupplier", fields: [supplierId], references: [id])

  receivedAt DateTime @map("received_at")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  consumptions MaterialLotConsumption[]

  @@index([productId, quantityRemaining])
  @@index([productId, storageLocationId, quantityRemaining])
  @@map("material_lots")
}

// ▸▸ FIFO 批次消耗记录（生产领料时按批次消耗）
model MaterialLotConsumption {
  id                         String                   @id @default(uuid())
  productionOrderComponentId String                   @map("production_order_component_id")
  productionOrderComponent   ProductionOrderComponent @relation(fields: [productionOrderComponentId], references: [id], onDelete: Cascade)
  materialLotId              String                   @map("material_lot_id")
  materialLot                MaterialLot              @relation(fields: [materialLotId], references: [id])
  quantity                   Decimal                  @db.Decimal(16, 4)
  postedById                 String                   @map("posted_by_id")
  postedBy                   User                     @relation("LotConsumed", fields: [postedById], references: [id])
  postedAt                   DateTime                 @default(now()) @map("posted_at")
  notes                      String?

  @@index([productionOrderComponentId])
  @@index([materialLotId])
  @@map("material_lot_consumptions")
}

// ▸▸ 成品批次（生产入库时生成）
model FinishedGoodLot {
  id        String @id @default(uuid())
  lotNumber String @unique @map("lot_number")

  productId         String          @map("product_id")
  product           Product         @relation("FgLotMaterial", fields: [productId], references: [id])
  productionOrderId String          @map("production_order_id")
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])

  quantity          Decimal         @db.Decimal(16, 4)
  unitOfMeasureId   String          @map("unit_of_measure_id")
  unitOfMeasure     UnitOfMeasure   @relation("FgLotUom", fields: [unitOfMeasureId], references: [id])
  storageLocationId String          @map("storage_location_id")
  storageLocation   StorageLocation @relation("FgLotLocation", fields: [storageLocationId], references: [id])

  receivedAt DateTime @default(now()) @map("received_at")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([productionOrderId])
  @@index([productId])
  @@map("finished_good_lots")
}

// ============================================================
// 九、仓库端 - 仓储费用
// ============================================================

model WarehouseExpense {
  id           String   @id @default(uuid())
  warehouseId  String?  @map("warehouse_id")
  expenseType  String   @map("expense_type") // rent / packaging / loss / salary / management / other
  amount       Decimal  @db.Decimal(14, 2)
  expenseMonth String   @map("expense_month") // YYYY-MM
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([expenseMonth])
  @@map("warehouse_expenses")
}

// ============================================================
// 十、运营端 - 订单与利润
// ============================================================

enum OrderStatus {
  PENDING_REVIEW // 待审核
  PENDING_SHIP // 待发货
  SHIPPED // 已发货
  DELIVERED // 已签收
  CANCELLED // 已取消
  ABNORMAL // 异常
}

enum PaymentStatus {
  PAID // 已支付
  UNPAID // 未支付
  REFUNDED // 已退款
  PARTIAL // 部分退款
}

model Order {
  id              String  @id @default(uuid())
  orderNumber     String  @unique @map("order_number")
  storeId         String  @map("store_id")
  platformOrderId String? @map("platform_order_id")

  // 客户信息
  customerName  String? @map("customer_name")
  customerEmail String? @map("customer_email")
  country       String

  // 金额
  currency       String  @default("USD")
  shippingAmount Decimal @default(0) @map("shipping_amount") @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount    Decimal @map("total_amount") @db.Decimal(12, 2)

  // 状态
  status         OrderStatus   @default(PENDING_REVIEW)
  paymentStatus  PaymentStatus @default(PAID) @map("payment_status")
  shippingStatus String?       @map("shipping_status")

  // 关联仓库
  warehouseId String?    @map("warehouse_id")
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  // 时间
  orderedAt   DateTime  @map("ordered_at")
  shippedAt   DateTime? @map("shipped_at")
  deliveredAt DateTime? @map("delivered_at")

  // 其他
  labels       Json? // 订单标签
  internalNote String?  @map("internal_note")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // 关联
  store     Store        @relation(fields: [storeId], references: [id])
  items     OrderItem[]
  logistics Logistics?
  refunds   AfterSales[]
  finance   OrderProfit?
  fees      OrderFee[]

  @@index([storeId])
  @@index([status])
  @@index([orderedAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  productId   String   @map("product_id")
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 4)
  totalAmount Decimal  @map("total_amount") @db.Decimal(12, 4)
  createdAt   DateTime @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model OrderFee {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  feeType   String   @map("fee_type") // platform_commission / advertising / logistics / aftersales / other
  amount    Decimal  @db.Decimal(12, 4)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_fees")
}

model OrderProfit {
  id      String @id @default(uuid())
  orderId String @unique @map("order_id")

  // 收入
  salesAmount  Decimal @map("sales_amount") @db.Decimal(14, 4) // 销售额
  refundAmount Decimal @default(0) @map("refund_amount") @db.Decimal(14, 4) // 退款

  // 成本分解
  productCost   Decimal @default(0) @map("product_cost") @db.Decimal(14, 4) // 生产成本
  warehouseCost Decimal @default(0) @map("warehouse_cost") @db.Decimal(14, 4) // 仓储分摊
  platformFee   Decimal @default(0) @map("platform_fee") @db.Decimal(14, 4) // 平台佣金
  adFee         Decimal @default(0) @map("ad_fee") @db.Decimal(14, 4) // 广告分摊
  logisticsFee  Decimal @default(0) @map("logistics_fee") @db.Decimal(14, 4) // 物流费
  aftersalesFee Decimal @default(0) @map("aftersales_fee") @db.Decimal(14, 4) // 售后损耗
  taxFee        Decimal @default(0) @map("tax_fee") @db.Decimal(14, 4) // 税费

  // 利润
  grossProfit  Decimal @default(0) @map("gross_profit") @db.Decimal(14, 4) // 毛利
  netProfit    Decimal @default(0) @map("net_profit") @db.Decimal(14, 4) // 净利润
  profitMargin Decimal @default(0) @map("profit_margin") @db.Decimal(6, 4) // 净利润率%

  calculatedAt DateTime @default(now()) @map("calculated_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_profits")
}

// ============================================================
// 十一、运营端 - 广告管理
// ============================================================

model AdCampaign {
  id                 String    @id @default(uuid())
  storeId            String    @map("store_id")
  platformCampaignId String?   @map("platform_campaign_id")
  campaignName       String    @map("campaign_name")
  campaignType       String    @map("campaign_type") // sp / sd / sa / info_feed / external
  spend              Decimal   @default(0) @db.Decimal(14, 4)
  impressions        Int       @default(0)
  clicks             Int       @default(0)
  orders             Int       @default(0)
  sales              Decimal   @default(0) @db.Decimal(14, 4)
  acos               Decimal?  @db.Decimal(6, 4) // Advertising Cost of Sales
  roas               Decimal?  @db.Decimal(6, 2) // Return on Ad Spend
  startDate          DateTime  @map("start_date")
  endDate            DateTime? @map("end_date")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([startDate])
  @@map("ad_campaigns")
}

// ============================================================
// 十二、售后端
// ============================================================

enum AfterSalesType {
  REFUND // 仅退款
  RETURN_REFUND // 退货退款
  EXCHANGE // 换货
  COMPLAINT // 投诉
  REPAIR // 维修
  RESEND // 补发
}

enum AfterSalesStatus {
  PENDING // 待处理
  PROCESSING // 处理中
  COMPLETED // 已完成
  REJECTED // 已拒绝
}

model AfterSales {
  id      String           @id @default(uuid())
  orderId String           @map("order_id")
  type    AfterSalesType   @default(REFUND)
  status  AfterSalesStatus @default(PENDING)

  refundAmount Decimal? @map("refund_amount") @db.Decimal(14, 4)
  logisticsFee Decimal? @map("logistics_fee") @db.Decimal(14, 4)
  compensation Decimal? @db.Decimal(14, 4) // 赔偿金
  lossAmount   Decimal? @map("loss_amount") @db.Decimal(14, 4) // 货损金额

  reason     String?
  resolution String? // 处理方案
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@map("after_sales")
}

// ============================================================
// 十三、物流管理
// ============================================================

enum LogisticsStage {
  FIRST_MILE // 头程（工厂→国内仓）
  DOMESTIC_WAREHOUSE // 国内仓
  INTERNATIONAL // 国际运输
  LAST_MILE // 尾程配送
  OVERSEAS_WAREHOUSE // 海外仓
}

enum LogisticsStatus {
  PENDING // 待发货
  IN_TRANSIT // 运输中
  DELIVERED // 已签收
  EXCEPTION // 异常
  RETURNED // 退回
}

model Logistics {
  id             String          @id @default(uuid())
  orderId        String          @unique @map("order_id")
  trackingNumber String?         @map("tracking_number")
  carrier        String? // 物流商(DHL/UPS/FedEx/燕文/云途等)
  channel        String? // 物流渠道(空运/海运/铁路/快递)
  stage          LogisticsStage  @default(FIRST_MILE)
  status         LogisticsStatus @default(PENDING)

  firstMileFee     Decimal @default(0) @map("first_mile_fee") @db.Decimal(14, 4)
  internationalFee Decimal @default(0) @map("international_fee") @db.Decimal(14, 4)
  lastMileFee      Decimal @default(0) @map("last_mile_fee") @db.Decimal(14, 4)
  totalFee         Decimal @default(0) @map("total_fee") @db.Decimal(14, 4)

  estimatedDelivery DateTime? @map("estimated_delivery")
  actualDelivery    DateTime? @map("actual_delivery")
  exceptionNote     String?   @map("exception_note")

  shippedAt   DateTime? @map("shipped_at")
  deliveredAt DateTime? @map("delivered_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([carrier])
  @@map("logistics")
}

// ============================================================
// 十四、审计日志
// ============================================================

model AuditLog {
  id          String   @id @default(uuid())
  entityType  String   @map("entity_type") // Order / Product / ProductionOrder / InventoryLedger ...
  entityId    String   @map("entity_id")
  action      String // CREATE / UPDATE / DELETE / APPROVE / REJECT / POST ...
  actorId     String   @map("actor_id")
  actor       User     @relation(fields: [actorId], references: [id])
  beforeState Json?    @map("before_state") // 变更前快照
  afterState  Json?    @map("after_state") // 变更后快照
  metadata    Json? // IP、UserAgent等
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}
