# ============================================
# 博纳ERP - 环境变量模板
# 复制此文件为 .env 并填入真实值
# ============================================

# ---------- 数据库 ----------
DATABASE_URL="postgresql://user:password@host:5432/bona_erp?schema=public"

# ---------- JWT ----------
JWT_SECRET="your-jwt-secret-here"
JWT_EXPIRES_IN="7d"

# ---------- 服务端口（仅本地开发）----------
PORT=3000

# ---------- 环境 ----------
NODE_ENV="development"

# ========== Cloudflare 配置 ==========
CLOUDFLARE_ACCOUNT_ID="your-account-id"
CLOUDFLARE_API_TOKEN="your-api-token"
CLOUDFLARE_GLOBAL_API_KEY="your-global-api-key"
CLOUDFLARE_EMAIL="sale@bona-official.com"
CLOUDFLARE_WORKER_NAME="bona-erp-api"
CLOUDFLARE_PAGES_PROJECT="bona-erp"
