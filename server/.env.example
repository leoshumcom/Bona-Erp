# ============================================
# 博纳ERP - 环境变量模板
# 复制此文件为 .env 并填入真实值
# ============================================

# ---------- 数据库 ----------
# 本地开发使用 SQLite（零依赖，开箱即用）
DATABASE_URL="file:./prisma/dev.db"
# 生产环境使用 Cloudflare D1（部署到 Workers 时自动切换）

# ---------- JWT ----------
JWT_SECRET="change-this-to-a-random-secret-in-production"
JWT_EXPIRES_IN="7d"

# ---------- 服务端口（仅本地开发）----------
PORT=3000

# ---------- 环境 ----------
NODE_ENV="development"

# ========== Cloudflare 部署配置（可选）==========
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_EMAIL=""
